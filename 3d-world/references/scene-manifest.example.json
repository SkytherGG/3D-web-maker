  "connectors": [
    {
      "id": "c1",
      "label": "The clouds",
      "clip": "video/conn1.mp4",
      "clipMobile": "video/conn1-m.mp4",
      "still": "img/conn1.webp",
      "sheet": { "src": "sprites/conn1.png", "cols": 4, "rows": 2 },
      "duration": 2.5,
      "blend": 0.5,
      "camera": { "from": { "scale": 1.15 }, "to": { "scale": 1.5 }, "ease": "in" }
    }
  ],
  "cta": {
    "eyebrow": "READY WHEN YOU ARE",
    "headline": "See it for real.",
    "sub": "One line of persuasion before the button.",
    "button": "Book your expedition",
    "href": "https://example.com/book",
    "showAt": 0.94
  },
  "audio": {
    "src": "audio/ambient.mp3",
    "volume": 0.35
  }
