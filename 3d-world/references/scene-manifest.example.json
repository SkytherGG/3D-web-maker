  },
  "sections": [
    {
      "id": "trailhead",
      "label": "01 — Trailhead",
      "eyebrow": "DAY 01 · THE BEGINNING",
      "title": "Where the journey starts",
      "body": "A warm lodge, a winding trail, and a sky full of morning mist.",
      "tags": ["Lodges", "Dawn", "Trails"],
      "clip": "video/trailhead.mp4",
      "clipMobile": "video/trailhead-m.mp4",
      "poster": "img/trailhead.webp",
      "still": "img/trailhead.webp",
      "sheet": { "src": "sprites/trailhead.png", "cols": 4, "rows": 2 },
      "duration": 6,
      "scroll": 1.2,
      "linger": 0.8,
      "camera": {
        "from": { "scale": 1.0,  "x": 0,    "y": 0,  "rotate": 0 },
